# Dependencies
# No trailing slash: a bare `node_modules` SYMLINK slipped past the
# directory-only pattern in PR #82 and was committed. On checkout git
# materialises it pointing at itself, npm cannot resolve the workspaces, and
# the dev server exits 194.
node_modules
apps/*/node_modules/
packages/*/node_modules/
.pnpm-store/

# Next.js
apps/web/.next/
apps/web/out/

# Env
.env
.env.local
apps/web/.env.local
# The local test stack's env (scripts/e2e-stack.sh up) — per-run keys.
apps/web/.env.e2e
deploy/.generated/
*.pem

# OS / IDE
.DS_Store
.idea/
.vscode/
*.log

# Misc
coverage/
dist/
backups/
tsconfig.tsbuildinfo
apps/web/tsconfig.tsbuildinfo
.vercel

# Flutter (cbse_school_mobile)
cbse_school_mobile/.dart_tool/
cbse_school_mobile/.flutter-plugins
cbse_school_mobile/.flutter-plugins-dependencies
cbse_school_mobile/.packages
cbse_school_mobile/build/
cbse_school_mobile/.pub-cache/
cbse_school_mobile/.pub/
cbse_school_mobile/**/Generated.xcconfig
cbse_school_mobile/**/flutter_export_environment.sh
cbse_school_mobile/ios/Pods/
cbse_school_mobile/ios/.symlinks/
cbse_school_mobile/android/.gradle/
cbse_school_mobile/android/local.properties
cbse_school_mobile/**/*.iml
cbse_school_mobile/.idea/

# Play Store build artifacts (regenerable) and assets
cbse_school_mobile/play-store-assets/app-release.aab
.claude/skills/

# Supabase CLI scratch (npx supabase writes its version cache here)
supabase/.temp/

# Deploy service-account key — must never be committed. It normally lives
# outside the repo (~/.config/bhb-deploy/), this is a guard in case one is
# ever dropped in the tree by mistake.
**/deploy-sa*.json
**/bhb-deploy*.json

# Reviewed-and-acted-on exports of live student/fee data — never committed.
open-ended-counter-discounts.csv
concession-grants-closed-2027-03-31.json

# Generated greeting-card PNGs (scripts/greeting-card.mjs) — regenerate, never commit.
/out/
# Playwright gate (step 1.1) outputs — uploaded as CI artifacts, never committed.
apps/web/e2e/report/
apps/web/e2e/test-results/
apps/web/e2e/month-groups-shots/
apps/web/e2e/month-range-shots/
apps/web/e2e/fuel-range-shots/
apps/web/e2e/counter-sales-shots/
apps/web/e2e/student-upgrade-shots/
apps/web/e2e/transport-paid-shots/
apps/web/e2e/scoreboard.json

apps/web/e2e/dues-screens-shots/
