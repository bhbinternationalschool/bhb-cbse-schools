# Copy to .env next to docker-compose.yml. Placeholders only — never commit
# the real file (the repo's .gitignore already ignores .env).

# ── n8n ────────────────────────────────────────────────────────────────
# 32+ random characters; encrypts credentials inside n8n's database.
# Generate: openssl rand -hex 24
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-24
N8N_VERSION=2.44.5
# Hostname and public URL once a tunnel or reverse proxy exists.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# ── Claude ─────────────────────────────────────────────────────────────
# A DEDICATED key named "n8n-office" in console.anthropic.com → API keys,
# so it can be rotated or revoked without touching anything else.
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# ── Supabase (the ERP's project) ───────────────────────────────────────
# Same project as NEXT_PUBLIC_SUPABASE_URL in deploy/env.production.example.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service-role key (Project settings → API). It bypasses RLS: the office
# workflows read ERP tables and write ONLY the four office_* tables.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# The school's tenant id — one SQL, see README "Find OFFICE_TENANT_ID".
OFFICE_TENANT_ID=00000000-0000-0000-0000-000000000000

# ── ERP (WhatsApp goes out through the ERP, never straight to Meta) ────
ERP_BASE_URL=https://bhbinternational.school
# Must equal WA_DISPATCH_SECRET on the Cloud Run service (deploy/env.production.example).
WA_DISPATCH_SECRET=replace-me
# 10-digit Indian mobiles, no +91. The director approves outward mail here.
DIRECTOR_WA_MOBILE=9999999999
# Optional: the principal also gets the 6 am substitution plan.
PRINCIPAL_WA_MOBILE=
# Optional: an APPROVED Meta utility template with one {{1}} body variable,
# used when the director has not written to the school number in 24 hours
# (Meta refuses free text outside that window). Leave empty to skip.
OFFICE_WA_TEMPLATE=bhb_school_notice
OFFICE_WA_TEMPLATE_LANG=en
# The template's body variables in order. The ERP's approved school-notice
# template takes three: school name, title (first line of the message), body.
OFFICE_WA_TEMPLATE_KEYS=schoolName,noticeTitle,noticeBody
OFFICE_SCHOOL_NAME=BHB International School
# Optional: the APPROVED "bhb_office_approval" template (body variables: draft
# id, summary; quick replies ✅ Approve / ❌ Reject). Used for an approval
# request when the director's 24-hour window is closed — the reply-buttons
# message the room sends inside the window cannot go out then. Leave empty
# and approvals fall back to OFFICE_WA_TEMPLATE like every other message.
OFFICE_WA_APPROVAL_TEMPLATE=bhb_office_approval
OFFICE_WA_APPROVAL_TEMPLATE_LANG=en

# ── Telegram (@BHB_Office_bot) ─────────────────────────────────────────
# The office bot's token from @BotFather — set it HERE on the VM only, never
# in the repo. With it set, the director and the principal get every internal
# message (approval requests, the 6 am plan, the huddle minutes) on Telegram
# and the WhatsApp chains above stay idle; empty, everything goes by WhatsApp
# as before. (@BHB_vns_bot is reserved for later — do not use it here.)
TELEGRAM_BOT_TOKEN=
# Chat ids: open the bot, send /start, and it answers with the chat id.
TELEGRAM_DIRECTOR_CHAT_ID=
TELEGRAM_PRINCIPAL_CHAT_ID=

# ── Gmail ──────────────────────────────────────────────────────────────
# The office address the Receptionist handles. The Gmail trigger only picks
# up mail sent TO this address (Gmail search `to:`), so the OAuth2 credential
# may be a person's mailbox that carries this address as an alias; their
# other mail is never read. Also names the inbox in notes.
SCHOOL_INBOX=office@bhbinternational.school

# ── Roster ─────────────────────────────────────────────────────────────
# Who speaks in the morning huddle, in order. Append a key to add an employee.
OFFICE_ROSTER=receptionist,academic_incharge
