{
  "manifest_version": 3,
  "name": "BHB Office Robot",
  "version": "1.1.0",
  "description": "For BHB International School staff: fills government portal forms (UDISE+ students, teachers and APAAR) from the school ERP. You check and save.",
  "permissions": ["storage"],
  "host_permissions": ["https://bhbinternational.school/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://sdms.udiseplus.gov.in/g1/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://teacher.udiseplus.gov.in/*"],
      "js": ["content-teacher.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "BHB Office Robot",
    "default_popup": "options.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "options.html"
}
