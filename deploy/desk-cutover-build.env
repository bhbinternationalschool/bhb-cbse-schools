# Desk-cutover build-time flags — NEXT_PUBLIC_*_READ_FROM_DB, inlined into the
# client bundle at build time (see apps/web/Dockerfile).
#
# COMMITTED as the source of truth so a Cloud Build TRIGGER — which checks out
# the repo and has no apps/web/.env.local — can build. Every value is "true":
# the localStorage->DB cutover is complete across all modules (verified against
# the live revision on 2026-08-23: 114 desk flags, all true). To change a
# module's read path, edit it here; deploy-online.sh --check warns if a local
# .env.local drifts from this file.
NEXT_PUBLIC_ACCOUNTS_READ_FROM_DB=true
NEXT_PUBLIC_ADMISSIONS_READ_FROM_DB=true
NEXT_PUBLIC_ATTENDANCE_READ_FROM_DB=true
NEXT_PUBLIC_AUTOMATION_READ_FROM_DB=true
