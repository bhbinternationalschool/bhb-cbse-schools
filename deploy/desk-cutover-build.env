NEXT_PUBLIC_GALLERY_READ_FROM_DB=true
NEXT_PUBLIC_HOMEWORK_READ_FROM_DB=true
NEXT_PUBLIC_LIBRARY_READ_FROM_DB=true
NEXT_PUBLIC_MASTERS_READ_FROM_DB=true
NEXT_PUBLIC_MODULE_REGISTRY_READ_FROM_DB=true
NEXT_PUBLIC_NEWS_READ_FROM_DB=true
NEXT_PUBLIC_NOTIFICATIONS_READ_FROM_DB=true
NEXT_PUBLIC_PAYMENTS_READ_FROM_DB=true
