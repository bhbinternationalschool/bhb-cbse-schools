# Runtime flags applied to the Cloud Run service after deploy.
# Committed source of truth for the trigger (no .env.local in the cloud).
# The desk-cutover flags are all "true" — cutover complete, verified against
# the live revision 2026-08-23. ERP_WA_COMMANDS is not one of them; see below.
ACCOUNTS_DUAL_WRITE_DB=true
ACCOUNTS_READ_FROM_DB=true
ADMISSIONS_DUAL_WRITE_DB=true
ADMISSIONS_READ_FROM_DB=true
ATTENDANCE_DUAL_WRITE_DB=true
ATTENDANCE_READ_FROM_DB=true
AUTOMATION_DUAL_WRITE_DB=true
AUTOMATION_READ_FROM_DB=true
CERTIFICATES_DUAL_WRITE_DB=true
CERTIFICATES_READ_FROM_DB=true
# The ERP command desk is ON by default — the variable is a kill switch, not
# an on switch, so an unset value enables it. This line keeps it OFF on
# deploy, because cloudbuild.yaml's --set-env-vars replaces the whole
# environment: an allowlist set by hand on the service would be wiped by the
# next deploy and the desk would come up live for every staff member with a
# mobile. Applied here instead, additively, in the same build — so there is
# no window in which it is on.
#
# To start the pilot, one update, which is one new revision:
#   gcloud run services update school-erp-web \
#     --project=school-erp-prod-493619 --region=asia-southeast1 \
#     --remove-env-vars=ERP_WA_COMMANDS \
#     --update-env-vars=ERP_WA_COMMANDS_ALLOW=<the director's mobile>
# See docs/ERP_COMMANDS_ROLLOUT.md. Delete this line to go school-wide.
ERP_WA_COMMANDS=off
ERP_CHAT_DUAL_WRITE_DB=true
ERP_CHAT_READ_FROM_DB=true
EXAMS_DUAL_WRITE_DB=true
EXAMS_READ_FROM_DB=true
EXAM_PAPERS_DUAL_WRITE_DB=true
EXAM_PAPERS_READ_FROM_DB=true
FEES_DUAL_WRITE_DB=true
FEES_READ_FROM_DB=true
FEE_RECOVERY_TASKS_DUAL_WRITE_DB=true
FEE_RECOVERY_TASKS_READ_FROM_DB=true
GALLERY_DUAL_WRITE_DB=true
GALLERY_READ_FROM_DB=true
HOMEWORK_DUAL_WRITE_DB=true
HOMEWORK_READ_FROM_DB=true
LIBRARY_DUAL_WRITE_DB=true
LIBRARY_READ_FROM_DB=true
MASTERS_DUAL_WRITE_DB=true
MASTERS_READ_FROM_DB=true
MODULE_REGISTRY_DUAL_WRITE_DB=true
MODULE_REGISTRY_READ_FROM_DB=true
NEWS_DUAL_WRITE_DB=true
NEWS_READ_FROM_DB=true
NEXT_PUBLIC_ACCOUNTS_READ_FROM_DB=true
NEXT_PUBLIC_ADMISSIONS_READ_FROM_DB=true
NEXT_PUBLIC_ATTENDANCE_READ_FROM_DB=true
NEXT_PUBLIC_AUTOMATION_READ_FROM_DB=true
NEXT_PUBLIC_CERTIFICATES_READ_FROM_DB=true
NEXT_PUBLIC_ERP_CHAT_READ_FROM_DB=true
