# Runtime flags applied to the Cloud Run service after deploy.
# Committed source of truth for the trigger (no .env.local in the cloud).
# The desk-cutover flags are all "true" — cutover complete, verified against
# the live revision 2026-08-23. ERP_WA_COMMANDS is not one of them; see below.
ACCOUNTS_DUAL_WRITE_DB=true
ACCOUNTS_READ_FROM_DB=true
ADMISSIONS_DUAL_WRITE_DB=true
ADMISSIONS_READ_FROM_DB=true
ATTENDANCE_DUAL_WRITE_DB=true
ATTENDANCE_READ_FROM_DB=true
AUTOMATION_DUAL_WRITE_DB=true
AUTOMATION_READ_FROM_DB=true
CERTIFICATES_DUAL_WRITE_DB=true
CERTIFICATES_READ_FROM_DB=true
# ERP_WA_COMMANDS is deliberately ABSENT. The variable is a kill switch, not
# an on switch — unset means the ERP command desk is ON — so the
# `ERP_WA_COMMANDS=off` line that used to sit here has been removed rather
# than commented out. WHO it is on for is decided by the allowlist below,
# which is a one-number pilot as of 2026-09-07, not by this variable.
#
# It has to be removed HERE, not just on the service. cloudbuild.yaml's
# --set-env-vars replaces the whole environment and this file is re-applied
# additively on every build, so a `gcloud run services update` that switched
# it on by hand would be undone by the next deploy. That is exactly what kept
# the desk off after the 2026-09-07 deploy while everyone assumed it was on.
#
# The desk is on a ONE-NUMBER PILOT, decided 2026-09-07. Only the mobiles
# listed below may use it; every other staff member sees exactly the
# WhatsApp they saw before the desk existed — no reply, no hint it exists.
#
# The value is committed rather than supplied from .env.local like the
# notify mobiles, and that is deliberate. An empty allowlist means EVERY
# staff member, so this variable fails OPEN. The build trigger has no
# .env.local, so a substitution defaulting to "" would quietly hand all 28
# staff with mobiles a desk that can message parents, on the first push
# that happened to deploy. A number in git is the smaller cost. It is the
# director's own mobile, already the protected super-admin on this tenant.
#
# To widen: add mobiles, comma-separated. To go school-wide: delete the
# line. To stop the desk entirely: put `ERP_WA_COMMANDS=off` back — but
# note that kills it for everyone including the director, and `commands
# on` from WhatsApp cannot undo it (check 1 runs before check 3).
# See docs/ERP_COMMANDS_ROLLOUT.md §4.
ERP_WA_COMMANDS_ALLOW=9919101755
ERP_CHAT_DUAL_WRITE_DB=true
ERP_CHAT_READ_FROM_DB=true
EXAMS_DUAL_WRITE_DB=true
EXAMS_READ_FROM_DB=true
EXAM_PAPERS_DUAL_WRITE_DB=true
EXAM_PAPERS_READ_FROM_DB=true
FEES_DUAL_WRITE_DB=true
FEES_READ_FROM_DB=true
FEE_RECOVERY_TASKS_DUAL_WRITE_DB=true
FEE_RECOVERY_TASKS_READ_FROM_DB=true
GALLERY_DUAL_WRITE_DB=true
GALLERY_READ_FROM_DB=true
HOMEWORK_DUAL_WRITE_DB=true
HOMEWORK_READ_FROM_DB=true
LIBRARY_DUAL_WRITE_DB=true
LIBRARY_READ_FROM_DB=true
MASTERS_DUAL_WRITE_DB=true
MASTERS_READ_FROM_DB=true
MODULE_REGISTRY_DUAL_WRITE_DB=true
MODULE_REGISTRY_READ_FROM_DB=true
NEWS_DUAL_WRITE_DB=true
NEWS_READ_FROM_DB=true
NEXT_PUBLIC_ACCOUNTS_READ_FROM_DB=true
