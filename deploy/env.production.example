# BHB International ERP — production environment template
# Copy to your hosting provider (Cloud Run, Vercel) or merge into apps/web/.env.local for deploy.
# Secrets: fill from Secret Manager / team vault — never commit real values.
#
# Full desk cutover flags: see deploy/desk-cutover.env.example (merged automatically on Cloud Run deploy)
# Deploy guide: deploy/README.md

# --- Public app identity ---
NEXT_PUBLIC_APP_URL=https://bhbinternational.school
NEXT_PUBLIC_SCHOOL_NAME=BHB International School
NEXT_PUBLIC_TENANT_SLUG=bhb-international
NEXT_PUBLIC_DEMO_AUTH=true

# --- Supabase (required for cross-browser / multi-device data) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pooler (migrations / server scripts only — not needed on Cloud Run runtime)
DATABASE_URL=
DIRECT_URL=

# --- Server integrations ---
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_LEAD_WEBHOOK_KEY=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_GRAPH_VERSION=v21.0

# Social cross-post (Facebook Page, Instagram Business, Telegram)
SOCIAL_CROSS_POST_ENABLED=true
META_APP_ID=
META_APP_SECRET=
# Manual token fallback (optional):
SOCIAL_META_ACCESS_TOKEN=
SOCIAL_FACEBOOK_PAGE_ID=
SOCIAL_INSTAGRAM_BUSINESS_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# TELEGRAM_CHANNEL_USERNAME=
# SOCIAL_DEFAULT_IMAGE_URL=
# SOCIAL_CROSS_POST_SECRET=

PROTECTED_SUPER_ADMIN_EMAILS=director@bhbinternational.school,ashishsingh80@gmail.com,ashu.dube21@gmail.com

MIRROR_SYNC_SECRET=
WA_DISPATCH_SECRET=
CRON_SECRET=
OPENAI_API_KEY=
AI_TUTOR_MODEL=gpt-4o-mini
# AI_PREFERRED_ENGINE=auto  # auto|openai|gemini

# BigQuery nightly sync (POST /api/analytics/bigquery-sync/tick)
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=bhb_erp
BIGQUERY_LOCATION=asia-south1
BIGQUERY_TENANT_SLUG=bhb-international
# BIGQUERY_SERVICE_ACCOUNT_JSON=
# BIGQUERY_SYNC_SECRET=

# Payment gateway (optional)
# NEXT_PUBLIC_PAYMENT_GATEWAY=razorpay
# NEXT_PUBLIC_PAYMENT_GATEWAY_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Track C desk cutover (DRP) ---
# Include ALL keys from deploy/desk-cutover.env.example in production.
# Cloud Run: ./scripts/deploy-online.sh merges apps/web/.env.local + template automatically.
# Vercel: paste deploy/desk-cutover.env.example into Project → Settings → Environment Variables.

# Admissions CRM
ADMISSIONS_DUAL_WRITE_DB=true
ADMISSIONS_READ_FROM_DB=true
NEXT_PUBLIC_ADMISSIONS_READ_FROM_DB=true

# Fees desk
FEES_DUAL_WRITE_DB=true
FEES_READ_FROM_DB=true
NEXT_PUBLIC_FEES_READ_FROM_DB=true

# … (all other modules — see deploy/desk-cutover.env.example for the complete list)
