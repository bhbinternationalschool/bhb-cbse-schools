{
  "manifest_version": 3,
  "name": "BHB UDISE+ Bridge",
  "version": "1.0.0",
  "description": "Autofill UDISE+ SDMS login from ERP vault and pull Students_Details into SIS.",
  "permissions": ["storage", "tabs", "scripting", "downloads"],
  "host_permissions": [
    "https://sdms.udiseplus.gov.in/*",
    "https://udiseplus.gov.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.bhbinternational.school/*",
    "https://erp.bhbinternational.school/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.bhbinternational.school/*",
      "https://erp.bhbinternational.school/*"
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "UDISE+ Bridge",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sdms.udiseplus.gov.in/*",
        "https://udiseplus.gov.in/*"
      ],
      "js": ["content/login-autofill.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sdms.udiseplus.gov.in/*",
        "https://udiseplus.gov.in/*"
      ],
      "js": ["content/session-observer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sdms.udiseplus.gov.in/*",
        "https://udiseplus.gov.in/*"
      ],
      "js": ["content/network-probe.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/bridge-protocol.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
