<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Staff-only permissions. These are the reason the two apps are
         separate: every one of them backs a staff feature, and none of them
         belongs in a build that parents install.

         Location is FOREGROUND only: it is read at the moment of a punch or a
         survey step, while the staff member is using the app. Background
         location ("all the time") and the presence-ping service were removed
         in 1.0.16 (director, 5 Oct 2026) — Play restricts that permission,
         and attendance no longer needs it (gate QR + phone key + live GPS).
         The lines with tools:node="remove" keep any plugin from merging the
         restricted permissions back in; scripts/build.sh fails if they appear. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove"/>

    <!-- Dictating lesson plan notes (speech_to_text). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Photographing a textbook contents page (image_picker). The camera
         is optional so the app still installs on camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <queries>
        <!-- Required on Android 11+ so speech_to_text can find the
             on-device recognition service. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
