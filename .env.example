# ATTENDANCE_READ_FROM_DB=true
# NEXT_PUBLIC_ATTENDANCE_READ_FROM_DB=true
# Phase 6 (staff attendance seeded from roster): uncomment after validate shows staff_attendance Ready=YES.
# STAFF_ATTENDANCE_READ_FROM_DB=true
# NEXT_PUBLIC_STAFF_ATTENDANCE_READ_FROM_DB=true
