# Demo mode: true = cookie persona login (staff blank → principal, no password).
# false = staff must use Supabase Auth (email/password → /api/auth/session cookie).
# Parent OTP / field PIN stay demo stubs either way. Cloud blob/SIS writes need a
# real Supabase Auth session (auth.uid) for RLS — set false once profiles are linked.
NEXT_PUBLIC_DEMO_AUTH=true

# Super-admin bootstrap emails (comma-separated)
PROTECTED_SUPER_ADMIN_EMAILS=director@bhbinternational.school,ashishsingh80@gmail.com,ashu.dube21@gmail.com

# School data mirror API (/api/school-data/mirror) — browser pushes require a
# demo session cookie. Optional shared secret for ops/scripts (header x-mirror-secret).
# WA bots / parent-pay read the in-process mirror file; they do not need this.
MIRROR_SYNC_SECRET=

# WhatsApp Meta Cloud API (server-only) — CRM admissions bot + campaigns
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_GRAPH_VERSION=v21.0
# WABA id for message template catalog sync (Masters → WhatsApp templates)
# Find in Meta: WhatsApp Manager, or auto-discovered as 1672893360375109 for BHB
WHATSAPP_WABA_ID=
# Aliases also accepted: WA_META_ACCESS_TOKEN, WA_PHONE_NUMBER_ID, WA_WEBHOOK_VERIFY_TOKEN, WA_GRAPH_API_VERSION, WA_BUSINESS_ACCOUNT_ID
# Optional BSP instead of Meta: WA_BSP_URL + WA_BSP_TOKEN
# Optional contacts lookup (number on WhatsApp?): WA_BSP_CONTACTS_URL (POST { contacts: ["91…"] })
# CRM: POST /api/wa/contacts-check { mobiles: string[] } — Admissions → Mobile/WhatsApp check
# Optional campaign dispatch guard: WA_DISPATCH_SECRET
# Automation tick (cron): POST /api/wa/automation/tick — also accepts CRON_SECRET
# Template sync: POST /api/wa/templates/sync
# Template submit (create on Meta): POST /api/wa/templates/submit { templateId, state }
# Token needs whatsapp_business_management for submit + whatsapp_business_messaging for send
# Webhook URL (Meta): https://<host>/api/wa/webhook
# Alias also accepted: https://<host>/api/whatsapp/webhook
# Subscribe to message_template_status_update for APPROVED/REJECTED/PAUSED
# Ops health: GET /api/integrations/health

# Ops health: GET /api/integrations/health

# Social cross-post — Facebook Page, Instagram Business, Telegram channel
# One-click OAuth (school staff — no token paste):
META_APP_ID=
META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=https://bhbinternational.school/api/integrations/social/meta-oauth/callback
# Connect: Communications → Social → Connect with Facebook

# Manual / fallback tokens (optional if using ERP Connect with Facebook):
SOCIAL_CROSS_POST_ENABLED=true
SOCIAL_META_ACCESS_TOKEN=
SOCIAL_FACEBOOK_PAGE_ID=
SOCIAL_INSTAGRAM_BUSINESS_ID=
# Optional fallback image for Instagram / photo posts (public HTTPS URL)
# SOCIAL_DEFAULT_IMAGE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# TELEGRAM_CHANNEL_USERNAME=my_school_channel
# Optional cron/script guard: SOCIAL_CROSS_POST_SECRET
# Comms → Social tab or checkboxes on publish forms
# API: POST /api/integrations/social/cross-post
# Setup guide: docs/SOCIAL_CROSS_POST.md

# Payment gateway (optional)
# NEXT_PUBLIC_PAYMENT_GATEWAY=demo|razorpay|cashfree
# NEXT_PUBLIC_PAYMENT_GATEWAY_KEY=   # Razorpay key_id (public)
# RAZORPAY_KEY_ID=                   # Same as above — server Razorpay Payment Links
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=           # Webhook → /api/payments/razorpay/webhook (auto ledger + WA receipt)
# Webhook: https://<host>/api/payments/razorpay/webhook

# Optional (production Cloud Run today)
REDIS_URL=
WA_DISPATCH_SECRET=
CRON_SECRET=
# OpenAI — homework tutor + exam paper assist (server-only; falls back to GEMINI_API_KEY)
OPENAI_API_KEY=
AI_TUTOR_MODEL=gpt-4o-mini

# BigQuery — nightly analytics warehouse (Supabase desk → BQ)
# Cron: POST /api/analytics/bigquery-sync/tick (CRON_SECRET or BIGQUERY_SYNC_SECRET)
# Manual: npm run sync:bigquery:dry  |  npm run sync:bigquery
# BIGQUERY_PROJECT_ID=school-erp-prod-493619
# BIGQUERY_DATASET=bhb_erp
# BIGQUERY_LOCATION=asia-south1
# BIGQUERY_TENANT_SLUG=bhb-international
# Service account JSON (local / non-GCP). On Cloud Run use workload identity instead.
# BIGQUERY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional dedicated cron header secret (else CRON_SECRET)
# BIGQUERY_SYNC_SECRET=

# Object storage: prefer Supabase bucket school-files (migration *_school_files_storage.sql)
# GCS optional fallback for server pipelines
# GCS_BUCKET=school-erp-assets
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/school-erp-assets

# Production domain when deploying
# NEXT_PUBLIC_APP_URL=https://bhbinternational.school
