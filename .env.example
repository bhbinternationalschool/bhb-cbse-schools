# --- Track C cutover (read-from-DB) ---
# Run: cd apps/web && npx tsx scripts/validate-desk-cutover.ts
# Enable BOTH server + NEXT_PUBLIC flags per module when validation shows Ready=YES.
# Phase 1 (admissions backfilled): uncomment below after validate passes.
# ADMISSIONS_READ_FROM_DB=true
# NEXT_PUBLIC_ADMISSIONS_READ_FROM_DB=true
# Phase 2 (SIS roster backfilled): uncomment after validate shows sis Ready=YES.
# SIS_READ_FROM_DB=true
# NEXT_PUBLIC_SIS_READ_FROM_DB=true
# Phase 3 (staff roster backfilled): uncomment after validate shows staff Ready=YES.
# STAFF_READ_FROM_DB=true
# NEXT_PUBLIC_STAFF_READ_FROM_DB=true
# Phase 4 (fees desk backfilled): uncomment after validate shows fees Ready=YES.
# FEES_READ_FROM_DB=true
# NEXT_PUBLIC_FEES_READ_FROM_DB=true
